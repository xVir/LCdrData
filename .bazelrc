common --enable_platform_specific_config

# rules_apple resolves the macOS SDK from the selected Xcode. Pinning
# DEVELOPER_DIR keeps a silent `xcode-select` switch from invalidating the
# entire action cache.
common --repo_env=DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer

build --macos_minimum_os=26.4
build --host_macos_minimum_os=26.4

test --test_output=errors

build:release --compilation_mode=opt

# Per-machine overrides — a remote cache, a different Xcode, extra flags. Optional:
# `try-import` is silent when the file is absent, and local.bazelrc is gitignored, so
# a clone without it builds normally. A `--remote_cache` that cannot be reached is a
# hard build failure, not a warning, which is why it must not live in this file.
try-import %workspace%/local.bazelrc
