load("@build_bazel_rules_swift//swift:swift_library.bzl", "swift_library")
load("//:defs.bzl", "PACKAGE_NAME", "SWIFT_COPTS")

# Key definitions, environment keys and path helpers that know nothing about the
# domain. A leaf: no first-party dependencies.
swift_library(
    name = "Utilities",
    srcs = glob(["*.swift"]),
    copts = SWIFT_COPTS,
    module_name = "Utilities",
    package_name = PACKAGE_NAME,
    visibility = ["//visibility:public"],
)
