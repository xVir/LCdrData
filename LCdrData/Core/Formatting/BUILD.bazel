load("@build_bazel_rules_swift//swift:swift_library.bzl", "swift_library")
load("//:defs.bzl", "PACKAGE_NAME", "SWIFT_COPTS")

# Presentation strings for model values: sizes, dates and file kinds. Its own
# module because it depends on Models, which Utilities must not.
swift_library(
    name = "Formatting",
    srcs = glob(["*.swift"]),
    copts = SWIFT_COPTS,
    module_name = "Formatting",
    package_name = PACKAGE_NAME,
    visibility = ["//visibility:public"],
    deps = ["//LCdrData/Core/Models"],
)
