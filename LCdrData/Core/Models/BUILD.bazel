load("@build_bazel_rules_swift//swift:swift_library.bzl", "swift_library")
load("//:defs.bzl", "PACKAGE_NAME", "SWIFT_COPTS")

# The domain types. A leaf: no first-party dependencies.
swift_library(
    name = "Models",
    srcs = glob(
        ["*.swift"],
        exclude = ["CommandCatalog.swift"],
    ),
    copts = SWIFT_COPTS,
    module_name = "Models",
    package_name = PACKAGE_NAME,
    visibility = ["//visibility:public"],
)

# The keyboard binding for each Command. Depends on both leaves, which is why it
# is a separate module from Models above.
swift_library(
    name = "Bindings",
    srcs = ["CommandCatalog.swift"],
    copts = SWIFT_COPTS,
    module_name = "Bindings",
    package_name = PACKAGE_NAME,
    visibility = ["//visibility:public"],
    deps = [
        ":Models",
        "//LCdrData/Core/Utilities",
    ],
)
