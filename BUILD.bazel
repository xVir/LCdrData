# Targets live in per-package BUILD files so each module can declare, via
# `visibility`, exactly which layers may depend on it. This package holds only
# the shared configuration below; `bazel query //...` lists the targets.

# Set by `--config=release` in .bazelrc.
config_setting(
    name = "release_build",
    values = {"compilation_mode": "opt"},
    visibility = ["//visibility:public"],
)
