# Machine-local Bazel settings. Not tracked in git; pulled in by `try-import` from
# .bazelrc, so removing this file just turns the settings off.

# bazel-remote (buchgr/bazel-remote-cache) in Docker, gRPC port 9092 published on
# 39092. 127.0.0.1 rather than localhost: the container binds IPv4 only, and gRPC
# would otherwise try ::1 first. Cache-only — no --remote_executor.
build --remote_cache=grpc://127.0.0.1:39092
build --remote_upload_local_results=true
build --remote_timeout=10s

# Select the installed Xcode explicitly so Bazel's xcode locator does not use
# a stale or otherwise unavailable version from its generated host config.
common --xcode_version=27.0
