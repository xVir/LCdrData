load("@build_bazel_rules_apple//apple:macos.bzl", "macos_unit_test")
load("@build_bazel_rules_swift//swift:swift_library.bzl", "swift_library")
load("//:defs.bzl", "PACKAGE_NAME", "SWIFT_COPTS")

# Tests for //LCdrData/App:AppEnvironment.
swift_library(
    name = "AppEnvironmentTestsLib",
    testonly = True,
    srcs = glob(["**/*.swift"]),
    copts = SWIFT_COPTS,
    module_name = "AppEnvironmentTests",
    package_name = PACKAGE_NAME,
    deps = [
        "//LCdrData/App:AppEnvironment",
        "//LCdrData/Core/Models",
        "//LCdrData/Services",
        "//LCdrData/ViewModels",
        "//LCdrDataTests/TestSupport",
    ],
)

macos_unit_test(
    name = "AppEnvironment",
    bundle_id = "com.xvir.LCdrData.AppEnvironmentTests",
    minimum_os_version = "26.4",
    size = "small",
    tags = ["local"],
    test_host = "//LCdrData",
    deps = [":AppEnvironmentTestsLib"],
)
