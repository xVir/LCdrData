load("@build_bazel_rules_apple//apple:macos.bzl", "macos_unit_test")
load("@build_bazel_rules_swift//swift:swift_library.bzl", "swift_library")
load("//:defs.bzl", "PACKAGE_NAME", "SWIFT_COPTS")

# Tests for //LCdrData/Core/Bindings.
swift_library(
    name = "BindingsTestsLib",
    testonly = True,
    srcs = glob(["*.swift"]),
    copts = SWIFT_COPTS,
    module_name = "BindingsTests",
    package_name = PACKAGE_NAME,
    deps = [
        "//LCdrData/Core/Bindings",
        "//LCdrData/Core/Models",
        "//LCdrData/Core/Utilities",
    ],
)

macos_unit_test(
    name = "Bindings",
    bundle_id = "com.xvir.LCdrData.BindingsTests",
    minimum_os_version = "26.4",
    size = "small",
    tags = ["local"],
    test_host = "//LCdrData",
    deps = [":BindingsTestsLib"],
)
