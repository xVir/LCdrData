load("@build_bazel_rules_apple//apple:macos.bzl", "macos_unit_test")
load("@build_bazel_rules_swift//swift:swift_library.bzl", "swift_library")
load("//:defs.bzl", "PACKAGE_NAME", "SWIFT_COPTS")

# Tests for the model types in //LCdrData/Core. Models and Utilities are one
# module in production because they are mutually dependent, but their tests are
# not: nothing here imports the Utilities tests, so they can be separate
# packages and separate targets.
swift_library(
    name = "ModelsTestsLib",
    testonly = True,
    srcs = glob(["*.swift"]),
    copts = SWIFT_COPTS,
    module_name = "ModelsTests",
    package_name = PACKAGE_NAME,
    deps = ["//LCdrData/Core"],
)

macos_unit_test(
    name = "Models",
    bundle_id = "com.xvir.LCdrData.ModelsTests",
    minimum_os_version = "26.4",
    size = "small",
    tags = ["local"],
    test_host = "//LCdrData",
    deps = [":ModelsTestsLib"],
)
