load("@build_bazel_rules_apple//apple:macos.bzl", "macos_unit_test")
load("@build_bazel_rules_swift//swift:swift_library.bzl", "swift_library")
load("//:defs.bzl", "PACKAGE_NAME", "SWIFT_COPTS")

swift_library(
    name = "AppTestsLib",
    testonly = True,
    srcs = glob(["**/*.swift"]),
    copts = SWIFT_COPTS,
    module_name = "AppTests",
    package_name = PACKAGE_NAME,
    deps = [
        "//LCdrData/App:AppEnvironment",
        "//LCdrData/App:LCdrDataLib",
        "//LCdrData/Services",
        "//LCdrDataTests/TestSupport",
    ],
)

macos_unit_test(
    name = "App",
    bundle_id = "com.xvir.LCdrData.AppTests",
    minimum_os_version = "26.4",
    size = "small",
    tags = ["local"],
    test_host = "//LCdrData",
    deps = [":AppTestsLib"],
)
